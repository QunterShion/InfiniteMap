{
    "compilerOptions": {
        "moduleResolution": "node",
        "noImplicitAny": true,
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "declaration": false
    },
    "include": ["src/mcp/**/*.ts"],
    "exclude": ["node_modules", "dist", ".vscode-test"]
}
